<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b6e4f">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icon-192.png">
<title>Bill Book</title>
<style>
:root{--bg:#f2f6f4;--ink:#12262b;--muted:#5d7176;--line:#d3dfdb;--accent:#0b6e4f;--card:#fff;--bad:#b3261e}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:16px;padding-bottom:calc(70px + env(safe-area-inset-bottom))}
header{background:var(--accent);color:#fff;padding:calc(12px + env(safe-area-inset-top)) 16px 12px;font-weight:700;font-size:18px}
main{max-width:560px;margin:0 auto;padding:14px}
nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom)}
nav button{flex:1;border:0;background:none;padding:14px 4px;font:inherit;font-size:14px;color:var(--muted)}
nav button[aria-current=true]{color:var(--accent);font-weight:700;box-shadow:inset 0 3px 0 var(--accent)}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px;margin-bottom:12px}
h2{font-size:15px;margin:0 0 8px;color:var(--muted);font-weight:600}
label{display:block;font-size:13px;margin:8px 0 3px;color:var(--muted)}
input,select{width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;font:inherit;background:#fff;color:var(--ink)}
button.b{background:var(--accent);color:#fff;border:0;border-radius:8px;padding:12px 16px;font:inherit;font-weight:600;width:100%;margin-top:8px}
button.b.alt{background:#fff;color:var(--accent);border:1px solid var(--accent)}
button.b.wa{background:#1f8f4e}
button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #7fc4ac;outline-offset:1px}
.row{display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:0}
.row .n{flex:1}.row .n small{display:block;color:var(--muted)}
.q{display:flex;align-items:center;gap:8px}
.q button{width:36px;height:36px;border-radius:50%;border:1px solid var(--accent);background:#fff;color:var(--accent);font-size:20px;line-height:1}
.q span{min-width:20px;text-align:center;font-weight:700}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.tot div{display:flex;justify-content:space-between;padding:3px 0}
.tot .g{font-size:20px;font-weight:700;border-top:1px solid var(--line);margin-top:4px;padding-top:8px}
.big{font-size:28px;font-weight:700}
.del{border:0;background:none;color:var(--bad);font:inherit;padding:8px}
.empty{color:var(--muted);text-align:center;padding:18px 0}
canvas{width:100%;height:auto;border:1px solid var(--line);border-radius:8px;background:#fff}
.hint{font-size:12px;color:var(--muted);margin:4px 0 0}
</style>
</head>
<body>
<header id="title">Bill Book</header>
<main>
 <section id="s-bill">
  <div class="card"><h2>Pick items</h2><div id="pick"></div></div>
  <div class="card">
   <h2>Discount and tax</h2>
   <div class="two">
    <div><label for="dval">Discount</label><input id="dval" type="number" min="0" step="any" inputmode="decimal" value="0"></div>
    <div><label for="dtype">Type</label><select id="dtype"><option value="r">Rupees (₹)</option><option value="%">Percent (%)</option></select></div>
   </div>
   <label for="tax">Tax (%)</label><input id="tax" type="number" min="0" step="any" inputmode="decimal" value="0">
  </div>
  <div class="card tot" id="tot"></div>
  <button class="b" id="make">Make bill and QR</button>
  <button class="b alt" id="clear">Clear</button>
 </section>

 <section id="s-view" hidden>
  <div class="card"><canvas id="cv" width="600" height="800"></canvas><p class="hint" id="qrnote"></p></div>
  <button class="b wa" id="share">Share on WhatsApp</button>
  <button class="b alt" id="dl">Download image</button>
  <button class="b alt" id="newbill">New bill</button>
 </section>

 <section id="s-hist" hidden>
  <div class="card"><h2>Today's total sales</h2><div class="big" id="today">₹0</div><div class="hint" id="todayn"></div></div>
  <div class="card"><h2>All bills</h2><div id="hist"></div></div>
 </section>

 <section id="s-set" hidden>
  <div class="card">
   <h2>Shop profile</h2>
   <label for="sname">Shop name</label><input id="sname">
   <label for="saddr">Address or phone</label><input id="saddr">
   <label for="supi">Your UPI ID (for the QR code)</label><input id="supi" placeholder="name@bank" autocapitalize="none" autocomplete="off">
   <p class="hint">Use your own UPI ID. The QR only asks for the bill amount to be paid to this ID.</p>
   <label for="stax">Default tax (%)</label><input id="stax" type="number" min="0" step="any" inputmode="decimal">
  </div>
  <div class="card">
   <h2>Item list</h2>
   <div class="two"><div><label for="iname">Item</label><input id="iname" placeholder="Rice 2 kg"></div>
   <div><label for="iprice">Price (₹)</label><input id="iprice" type="number" min="0" step="any" inputmode="decimal"></div></div>
   <button class="b" id="addi">Add item</button>
   <div id="ilist" style="margin-top:8px"></div>
  </div>
 </section>
</main>
<nav>
 <button data-t="bill" aria-current="true">New bill</button>
 <button data-t="hist">History</button>
 <button data-t="set">Setup</button>
</nav>

