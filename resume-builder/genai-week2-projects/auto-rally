 x.fillStyle="#12262b";F(22);
 lines.forEach(l=>{x.textAlign="left";x.fillText(l.n+"  x"+l.q,P,y);x.textAlign="right";x.fillText(money(l.p*l.q),W-P,y);y+=34});
 y-=6;x.beginPath();x.moveTo(P,y);x.lineTo(W-P,y);x.stroke();y+=34;
 const line=(k,v)=>{x.textAlign="left";x.fillText(k,P,y);x.textAlign="right";x.fillText(v,W-P,y);y+=34};
 line("Subtotal",money(b.sub));if(b.disc)line("Discount","− "+money(b.disc));if(b.tax)line("Tax",money(b.tax));
 F(30,"bold");y+=6;line("Total",money(b.total));
 if(b.link){const q=qrFor(b.link);if(q){const n=q.getModuleCount(),s=Math.floor(300/n),sz=s*n,ox=(W-sz)/2;y+=14;
  x.fillStyle="#fff";x.fillRect(ox-12,y-12,sz+24,sz+24);x.fillStyle="#000";
  for(let r=0;r<n;r++)for(let k=0;k<n;k++)if(q.isDark(r,k))x.fillRect(ox+k*s,y+r*s,s,s);
  y+=sz+44;x.fillStyle="#5d7176";F(18);x.textAlign="center";x.fillText("Scan with any UPI app to pay "+money(b.total),W/2,y);y+=10}}
 const out=document.createElement("canvas");out.width=W;out.height=y+30;out.getContext("2d").drawImage(c,0,0);
 return out;
}
function viewBill(b){
 current=b;const cv=drawBill(b);const t=$("cv");t.width=cv.width;t.height=cv.height;t.getContext("2d").drawImage(cv,0,0);
 $("qrnote").textContent=b.link?"":"Add your UPI ID in Setup to get a payment QR on bills.";
 showTab("view");
}
$("make").onclick=()=>{
 const lines=curLines();if(!lines.length){alert("Add at least one item.");return}
 const c=curCalc(),b={no:S.next++,ts:Date.now(),shop:S.shop.name,addr:S.shop.addr,items:lines,dtype:$("dtype").value,dval:parseFloat($("dval").value)||0,rate:parseFloat($("tax").value)||0,...c};
 b.link=upiLink(b);S.bills.push(b);save();viewBill(b);
};
$("newbill").onclick=()=>{$("clear").click();showTab("bill")};
function blobOf(){return new Promise(r=>$("cv").toBlob(r,"image/png"))}
$("dl").onclick=async()=>{const bl=await blobOf(),a=document.createElement("a");a.href=URL.createObjectURL(bl);a.download="bill-"+current.no+".png";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1500)};
$("share").onclick=async()=>{
 const bl=await blobOf(),f=new File([bl],"bill-"+current.no+".png",{type:"image/png"});
 const text=(current.shop||"Bill")+" - Bill #"+current.no+": "+money(current.total);
 try{if(navigator.canShare&&navigator.canShare({files:[f]})){await navigator.share({files:[f],text});return}}catch(e){if(e.name==="AbortError")return}
 $("dl").click();window.open("https://wa.me/?text="+encodeURIComponent(text),"_blank");
};

function renderHist(){
 const day=d=>new Date(d).toDateString(),td=S.bills.filter(b=>day(b.ts)===day(Date.now()));
 $("today").textContent=money(td.reduce((a,b)=>a+b.total,0));$("todayn").textContent=td.length+" bill"+(td.length===1?"":"s")+" today";
 const h=$("hist");h.innerHTML="";
 if(!S.bills.length){h.innerHTML='<div class="empty">No bills yet.</div>';return}
 S.bills.slice().reverse().forEach(b=>{
  const r=document.createElement("div");r.className="row";r.style.cursor="pointer";r.tabIndex=0;
  r.innerHTML='<div class="n"><b>#'+b.no+'</b><small>'+new Date(b.ts).toLocaleString("en-IN",{dateStyle:"medium",timeStyle:"short"})+'</small></div><b>'+money(b.total)+'</b>';
  r.onclick=()=>viewBill(b);r.onkeydown=e=>{if(e.key==="Enter")viewBill(b)};h.appendChild(r);
 });
}

/* setup */
function renderSet(){
 $("sname").value=S.shop.name;$("saddr").value=S.shop.addr;$("supi").value=S.shop.upi;$("stax").value=S.shop.tax||"";
 const l=$("ilist");l.innerHTML="";
 if(!S.items.length)l.innerHTML='<div class="empty">No items yet.</div>';
 S.items.forEach(i=>{
  const r=document.createElement("div");r.className="row";
  r.innerHTML='<div class="n"><b></b></div><span>'+money(i.p)+'</span><button class="del">Delete</button>';
  r.querySelector("b").textContent=i.n;
  r.querySelector("button").onclick=()=>{S.items=S.items.filter(z=>z.id!==i.id);delete cart[i.id];save();renderSet();renderPick();renderTot()};
  l.appendChild(r);
 });
}
[["sname","name"],["saddr","addr"],["supi","upi"]].forEach(([id,k])=>$(id).addEventListener("input",()=>{S.shop[k]=$(id).value.trim();save()}));
$("stax").addEventListener("input",()=>{S.shop.tax=parseFloat($("stax").value)||0;save();$("tax").value=S.shop.tax});
$("addi").onclick=()=>{
 const n=$("iname").value.trim(),p=toPaise($("iprice").value);
 if(!n||p<=0){alert("Enter an item name and a price above 0.");return}
 S.items.push({id:Date.now()+Math.random().toString(36).slice(2,6),n,p});save();$("iname").value="";$("iprice").value="";renderSet();renderPick();
};

$("tax").value=S.shop.tax||0;renderSet();renderPick();renderTot();showTab("bill");
if("serviceWorker" in navigator&&location.protocol.startsWith("http"))navigator.serviceWorker.register("sw.js").catch(()=>{});
</script>
</body>
